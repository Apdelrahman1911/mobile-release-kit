<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<installer-gui-script minSpecVersion="2">
    <title>Prepare Xcode for MobileReleaseKit</title>
    <options customize="never" require-scripts="false" allow-external-scripts="false" rootVolumeOnly="true"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <volume-check script="true">
        <allowed-os-versions>
            <os-version min="26.0" before="27.0"/>
        </allowed-os-versions>
    </volume-check>
    <readme file="InstallerReadMe.html"/>
    <choices-outline>
        <line choice="prepare-xcode"/>
    </choices-outline>
    <choice id="prepare-xcode" title="Prepare Xcode" visible="false">
        <pkg-ref id="dev.mobile-release-kit.desktop.xcode-setup"/>
    </choice>
    <pkg-ref id="dev.mobile-release-kit.desktop.xcode-setup" version="0.1.2" auth="root" installKBytes="2" updateKBytes="0">#PrepareXcode.pkg</pkg-ref>
    <pkg-ref id="dev.mobile-release-kit.desktop.xcode-setup">
        <bundle-version>
            <bundle CFBundleVersion="0.1.2" id="dev.mobile-release-kit.desktop.xcode-setup.carrier" path="MobileReleaseKitXcodeSetup.bundle"/>
        </bundle-version>
    </pkg-ref>
</installer-gui-script>