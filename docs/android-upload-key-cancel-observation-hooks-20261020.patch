+) -> Option<bool> {
+    let slot = state.slot.as_ref()?;
+    if slot.operation != Operation::RecoverUploadKey || slot.owner.id != 8
+        || state.unknown || slot.owner.stopped() || slot.reason != Reason::None
+        || slot.error.is_some() || slot.settlement == Settlement::Unknown
