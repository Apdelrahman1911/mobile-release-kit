--- a/tests/workflow/test_native_profile_ci.py
+++ b/tests/workflow/test_native_profile_ci.py
@@ -17,0 +18,36 @@ class NativeProfileCITests(unittest.TestCase):
+    def test_macos_upload_process_contracts_require_all_suites_and_pinned_ruby(self):
+        workflow = load_workflow(Path(__file__).parents[2] / ".github/workflows/ci.yml")
+        native = workflow["jobs"]["test-native-profiles"]
+        linux_ruby = next(step for step in workflow["jobs"]["test-linux"]["steps"]
+                          if step.get("uses", "").startswith("ruby/setup-ruby@"))
+        ruby = next(step for step in native["steps"]
+                    if step["name"] == "Set up pinned Ruby for native process contracts")
+        self.assertEqual(ruby["uses"], linux_ruby["uses"])
+        self.assertEqual(ruby["with"], {"ruby-version": "3.3.12", "bundler-cache": True})
+        step = next(step for step in native["steps"]
+                    if step["name"] == "Require macOS upload process contracts")
+        self.assertLess(native["steps"].index(ruby), native["steps"].index(step))
+        for required in (ruby, step):
+            self.assertNotIn("if", required)
+            self.assertNotIn("continue-on-error", required)
+            self.assertNotIn("env", required)
+        ios = "tests/workflow/test_ios_upload_validation.rb"
+        android = "tests/workflow/test_android_upload_validation.rb"
+        shared = "tests/workflow/test_native_upload_validation.rb"
+        # Execute the actual workflow shell, not a search for reassuring text.
+        # A shell function avoids adding another fresh-executable startup race.
+        fixture = '''bundle() {
+  [[ "$#" == 3 && "$1" == exec && "$2" == ruby ]] || return 99
+  printf '%s\\n' "$3"
+  [[ "$3" != "$FAIL_SUITE" ]]
+}
+'''
+        for failed, expected_calls in (("none", [ios, android, shared]), (ios, [ios]),
+                                       (android, [ios, android]), (shared, [ios, android, shared])):
+            with self.subTest(failed=failed):
+                result = subprocess.run(["bash", "-c", fixture + step["run"]],
+                                        capture_output=True, text=True, timeout=10,
+                                        env={"PATH": os.environ["PATH"], "FAIL_SUITE": failed})
+                self.assertEqual(result.returncode == 0, failed == "none", result.stderr)
+                self.assertEqual(result.stdout.splitlines(), expected_calls)
+
