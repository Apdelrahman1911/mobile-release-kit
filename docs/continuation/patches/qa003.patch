@@ -0,0 +1,134 @@
+"""Fork while an owned worker is live; child unwinds without killing its parent worker."""
+from __future__ import annotations
+
+import gc
+import json
+import os
+import selectors
+import signal
+import subprocess
+import sys
+import time
+from contextlib import ExitStack
+from pathlib import Path
+from unittest.mock import patch
+
+if __name__ == '__main__':
+    sys.path.insert(0, sys.argv.pop(1))
+
+from mobile_release import ios_profiles, local_signing, owned_process
+from mobile_release.cancellation import OwnedTemporaryDirectory
+from mobile_release.errors import MobileReleaseError
+from mobile_release.inspection import InspectionDeadline
+
+
+def main(root: Path, mode: str) -> None:
+    parent = os.getpid()
+    ready, release, report = (root / name for name in ('ready', 'release', 'child.json'))
+    real_spawn, real_selector = subprocess.Popen, selectors.DefaultSelector
+    processes, streams, forked, children = [], [], [], []
+    scratch = OwnedTemporaryDirectory(prefix='parent-required-', dir=root)
+    scratch.acquire()
+    required = Path(scratch.name) / 'required'
+    required.write_bytes(b'fictional-parent-resource')
+    code = (f'import os,signal,time;from pathlib import Path;Path({str(ready)!r}).touch();'
+            f'\nend=time.monotonic()+8\n'
+            f'while not Path({str(release)!r}).exists() and time.monotonic()<end:time.sleep(.01)\n')
+    if mode.startswith('capture'):
+        frame = ios_profiles.completion_frame(b'fictional-profile-content')
+        code += f'os.write(1,bytes.fromhex({frame.hex()!r}));os.killpg(os.getpgrp(),signal.SIGKILL)'
+    command = [sys.executable, '-I', '-S', '-B', '-c', code]
+
+    def fork_and_wait():
+        forked.append(True)
+        child = os.fork()
+        if child == 0:
+            return
+        children.append(child)
+        expires = time.monotonic() + 5
+        while time.monotonic() < expires:
+            waited, status = os.waitpid(child, os.WNOHANG)
+            if waited:
+                children.remove(child)
+                assert os.waitstatus_to_exitcode(status) == 0
+                result = json.loads(report.read_text())
+                assert result == {
+                    'workerStillAlive': True, 'childHandlesClosed': True,
+                    'typedOwnershipRefusal': True, 'parentScratchRetained': True,
+                }, result
+                release.touch()
+                return
+            time.sleep(.01)
+        raise AssertionError('owned fork child did not exit')
+
+    def spawn(*args, **kwargs):
+        process = real_spawn(*args, **kwargs)
+        processes.append(process)
+        streams.extend(stream for stream in (process.stdin, process.stdout) if stream is not None)
+        if mode.endswith('open') and not forked:
+            fork_and_wait()
+        return process
+
+    class Selector(real_selector):
+        def select(self, timeout=None):
+            events = super().select(timeout)
+            if mode.endswith('active') and ready.is_file() and not forked:
+                fork_and_wait()
+            return events
+
+    error = None
+    try:
+        with local_signing.local_signing_lease(home=root):
+            with ExitStack() as patches:
+                patches.enter_context(patch.object(subprocess, 'Popen', new=spawn))
+                patches.enter_context(patch.object(selectors, 'DefaultSelector', Selector))
+                if mode.startswith('capture'):
+                    patches.enter_context(patch.object(ios_profiles, 'worker_command', return_value=command))
+                    value = ios_profiles.authenticate_cms(b'fictional-cms', deadline=InspectionDeadline())
+                    assert value == b'fictional-profile-content'
+                else:
+                    assert owned_process.run_owned(command, timeout=15).returncode == 0
+    except BaseException as caught:
+        error = caught
+    if os.getpid() != parent:
+        alive = True
+        for process in processes:
+            try:
+                os.killpg(process.pid, 0)  # Non-mutating proof before parent resumes.
+            except ProcessLookupError:
+                alive = False
+        gc.collect()
+        report.write_text(json.dumps({
+            'workerStillAlive': alive, 'childHandlesClosed': all(stream.closed for stream in streams),
+            'typedOwnershipRefusal': isinstance(error, MobileReleaseError),
+            'parentScratchRetained': required.read_bytes() == b'fictional-parent-resource',
+        }))
+        return  # Normal interpreter GC/exit cannot erase parent's required scratch.
+    try:
+        assert not children
+        if error is not None:
+            raise error
+        assert forked
+        assert required.read_bytes() == b'fictional-parent-resource'
+        assert all(stream.closed for stream in streams)
+        for process in processes:
+            assert process.returncode is not None
+            try:
+                os.killpg(process.pid, 0)
+            except ProcessLookupError:
+                pass
+            else:
+                raise AssertionError('owned process group still exists')
+        print(json.dumps({'checkedBeforeFallback': True, 'mode': mode}))
+    finally:
+        release.touch()
+        for process in processes:
+            if process.returncode is None:
+                owned_process.reap_group(process)
+        for stream in streams:
+            stream.close()
+        scratch.cleanup()
+
+
+if __name__ == '__main__':
+    main(Path(sys.argv[1]), sys.argv[2])
