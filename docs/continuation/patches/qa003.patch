+class TTY(io.StringIO):
+    def __init__(self, callback=None):
+        super().__init__()
+        self.reads, self.callback = 0, callback
+
+    def isatty(self):
+        return True
+
+    def readline(self, maximum):
+        self.reads += 1
+        if self.callback is not None:
+            self.callback()
+        return "recheck " + TOKEN + "\n"
