+    def test_actual_fatal_owned_process_in_body_cannot_finalize_or_release_signing_resources(self):
+        root, home, destination, model = self.case(seed=False)
+        real_selector, real_spawn = selectors.DefaultSelector, subprocess.Popen
+        held, workers = [], []
+
+        class RetainedSelector:
+            def __init__(self):
+                self.actual = real_selector()
+                held.append(self.actual)
+
+            def __getattr__(self, name):
+                return getattr(self.actual, name)
+
+            def close(self):
+                raise OSError("fictional-private-close-canary")
+
+        def spawn(*args, **kwargs):
+            worker = real_spawn(*args, **kwargs)
+            workers.append(worker)
+            return worker
