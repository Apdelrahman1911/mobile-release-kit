+"""Bounded synchronous commands with owned descendants and parent-death cleanup.
+
+This is private trusted-child IPC, not artifact authenticity. Shared OS services
+and hostile same-UID process-group escapes are not a containment guarantee.
+"""
+from __future__ import annotations
+
+import base64
+import json
+import os
+import selectors
+import signal
+import subprocess
+import sys
+import time
+from collections.abc import Callable, Mapping, Sequence
+from pathlib import Path
+from sys import exc_info
+
+from .cancellation import CleanupScope, DefaultCancellation, cancellation_owner
+from .errors import CredentialError, ValidationError
+
+REQUEST_LIMIT = 2 * 1024 * 1024
+OUTPUT_LIMIT = 16 * 1024 * 1024
+PRIVATE_OUTPUT_LIMIT = 2 * 1024 * 1024
+REQUEST_MAGIC = b"MRK-COMMAND\x01\n"
+RESULT_MAGIC = b"MRK-RESULT\x01\n"
+RESULT_END = b"\x00MRK-COMMAND-COMPLETE\x01\n"
+CLEANUP_SECONDS = 3
+CLEANUP_RETRIES = 60
+BOOTSTRAP = (
+    "import sys; sys.path.insert(0, sys.argv.pop(1)); "
+    "from mobile_release.owned_process import main; raise SystemExit(main())"
+)
+
+
+class ProcessError(ValidationError, CredentialError):
+    """No complete command result; dispatch/containment must not be guessed."""
+
+    def __init__(self, message: str, *, dispatched: bool = False, contained: bool = True,
+                 cleanup_complete: bool = True):
+        super().__init__(message)
+        self.dispatched, self.contained = dispatched, contained
+        self.cleanup_complete = cleanup_complete
+
+    @property
+    def fatal(self) -> bool:
+        """Group absence alone does not discharge handles or cancellation ownership."""
+        return not self.contained or not self.cleanup_complete
+
+
+class ProcessCleanupError(ProcessError):
+    """Abort further work, even when the command group itself is already absent."""
+
+    def __init__(self, message: str, *, dispatched: bool = False, contained: bool = True):
+        super().__init__(message, dispatched=dispatched, contained=contained, cleanup_complete=False)
+
+
+class ProcessInterrupted(KeyboardInterrupt):
+    def __init__(self, *, dispatched: bool, contained: bool):
+        super().__init__()
+        self.dispatched, self.contained = dispatched, contained
+
+
+def preserve_lifetime_error(
+    error: ProcessError, *, previous: BaseException | None = None,
+    dispatched: bool = False, contained: bool = True,
+) -> ProcessError:
+    """Later cleanup/handler errors cannot erase an earlier typed lifetime result.
+
+    Combine only explicit observations, never error text. Python retains the
+    active exception as context even when a finally/handler raises a new one.
+    This also preserves cancellation dispatch across a failing cleanup.
+    """
+    pending, seen = [error, previous], set()
+    cleanup_complete = True
+    while pending:
+        current = pending.pop()
+        if current is None or id(current) in seen:
+            continue
+        seen.add(id(current))
+        if isinstance(current, (ProcessError, ProcessInterrupted)):
+            dispatched = dispatched or current.dispatched
+            contained = contained and current.contained
+            if isinstance(current, ProcessError):
+                cleanup_complete = cleanup_complete and current.cleanup_complete
+        pending.extend((current.__context__, current.__cause__))
+    error.dispatched, error.contained = dispatched, contained
+    error.cleanup_complete = cleanup_complete
+    return error
+
+
+def fatal_lifetime_error(error: BaseException | None, message: str) -> ProcessError | None:
+    """Recover typed fatal facts hidden by a later ordinary cleanup exception.
+
+    A generic exception alone proves no process/handle uncertainty. Callers that
+    catch and continue independent cleanup must also retain prior nonfatal facts
+    explicitly: ExitStack.close() can detach callback exception contexts.
+    """
+    if error is None:
+        return None
+    observed = error if isinstance(error, ProcessError) else ProcessError(message)
+    preserve_lifetime_error(observed, previous=error)
+    return observed if observed.fatal else None
+
+
+def _json(value: object) -> bytes:
+    return json.dumps(value, ensure_ascii=True, sort_keys=True, separators=(",", ":"), allow_nan=False).encode("ascii")
+
+
+def _pairs(items: list[tuple[str, object]]) -> dict:
+    result = {}
+    for key, value in items:
+        if key in result:
+            raise ValueError("duplicate command control")
+        result[key] = value
+    return result
+
+
+def _parse(content: bytes) -> dict:
+    result = json.loads(content, object_pairs_hook=_pairs,
+                        parse_constant=lambda _: (_ for _ in ()).throw(ValueError()))
+    if type(result) is not dict:
+        raise ValueError("invalid command control")
+    return result
+
+
+def _valid_request(value: dict) -> None:
+    if set(value) != {"argv", "cwd", "capture", "limit"}:
+        raise ValueError("invalid command request")
+    args = value["argv"]
+    if (type(args) is not list or not 0 < len(args) <= 4096
+            or any(type(arg) is not str or "\x00" in arg or len(arg) > REQUEST_LIMIT for arg in args)
+            or not args[0] or type(value["cwd"]) is not str
+            or not os.path.isabs(value["cwd"]) or "\x00" in value["cwd"]
+            or type(value["capture"]) is not bool or type(value["limit"]) is not int
+            or not 0 < value["limit"] <= OUTPUT_LIMIT):
+        raise ValueError("invalid command request")
+
+
+def _require_lifetime(parent: int, expires: float) -> None:
+    if os.getppid() != parent or time.monotonic() >= expires:
+        raise TimeoutError("owned command lifetime ended")
+
+
+def _read_request(parent: int, expires: float) -> dict:
+    descriptor = sys.stdin.fileno()
+    os.set_blocking(descriptor, False)
+    content = bytearray()
+    header = len(REQUEST_MAGIC) + 4
+    with selectors.DefaultSelector() as selector:
+        selector.register(descriptor, selectors.EVENT_READ)
+        while True:
+            _require_lifetime(parent, expires)
+            for _, _ in selector.select(0.05):
+                try:
+                    chunk = os.read(descriptor, 64 * 1024)
+                except BlockingIOError:
+                    continue
+                if not chunk:
+                    raise ValueError("incomplete command request")
+                content.extend(chunk)
+                if len(content) > header + REQUEST_LIMIT:
+                    raise ValueError("oversized command request")
+                if len(content) >= header:
+                    length = int.from_bytes(content[len(REQUEST_MAGIC):header], "big")
+                    if not content.startswith(REQUEST_MAGIC) or not 0 < length <= REQUEST_LIMIT:
+                        raise ValueError("invalid command frame")
+                    if len(content) >= header + length:
+                        if len(content) != header + length:
+                            raise ValueError("trailing command data")
+                        request = _parse(bytes(content[header:]))
+                        _valid_request(request)
+                        return request
+
+
+def _native_result(request: dict, parent: int, expires: float) -> dict:
+    output, errors = bytearray(), bytearray()
+    try:
+        process = subprocess.Popen(
+            request["argv"], cwd=request["cwd"], stdin=subprocess.DEVNULL,
+            stdout=subprocess.PIPE if request["capture"] else subprocess.DEVNULL,
+            stderr=subprocess.PIPE if request["capture"] else subprocess.DEVNULL,
+            # Inherit only the explicitly scoped supervisor environment/group.
+        )
+    except OSError:
+        return {"exit": None, "stdout": "", "stderr": "", "spawnFailed": True}
+    with selectors.DefaultSelector() as selector:
+        for stream, buffer in ((process.stdout, output), (process.stderr, errors)):
+            if stream is not None:
+                os.set_blocking(stream.fileno(), False)
+                selector.register(stream, selectors.EVENT_READ, buffer)
+        while selector.get_map() or process.poll() is None:
+            _require_lifetime(parent, expires)
+            for key, _ in selector.select(0.05):
+                try:
+                    chunk = os.read(key.fd, 64 * 1024)
+                except BlockingIOError:
+                    continue
+                if chunk:
+                    key.data.extend(chunk)
+                    if len(output) + len(errors) > request["limit"]:
+                        raise ValueError("owned command output bound exceeded")
+                else:
+                    selector.unregister(key.fileobj)
+                    key.fileobj.close()
+            if not selector.get_map() and process.poll() is None:
+                time.sleep(0.01)
+        _require_lifetime(parent, expires)
+        return {"exit": process.wait(), "stdout": base64.b64encode(output).decode("ascii"),
+                "stderr": base64.b64encode(errors).decode("ascii"), "spawnFailed": False}
+
+
+def supervise(parent: int, expires: float) -> int:
+    leader = os.getpid()
+    if os.getpgrp() != leader or parent <= 1:
+        return 1  # This must never authorize killing another process group.
+    try:
+        _require_lifetime(parent, expires)
+        request = _read_request(parent, expires)
+        _require_lifetime(parent, expires)
+        payload = _json(_native_result(request, parent, expires))
+        frame = RESULT_MAGIC + len(payload).to_bytes(4, "big") + payload + RESULT_END
+        descriptor = sys.stdout.fileno()
+        os.set_blocking(descriptor, False)
+        with selectors.DefaultSelector() as selector:
+            selector.register(descriptor, selectors.EVENT_WRITE)
+            for part in (frame[:-len(RESULT_END)], RESULT_END):
+                remaining = memoryview(part)
+                while remaining:
+                    _require_lifetime(parent, expires)
+                    for _, _ in selector.select(0.05):
+                        _require_lifetime(parent, expires)
+                        try:
+                            count = os.write(descriptor, remaining[:64 * 1024])
+                        except BlockingIOError:
+                            continue
+                        if count <= 0:
+                            raise OSError("incomplete command output")
+                        remaining = remaining[count:]
+        return 0
+    finally:
+        # Also runs after fully emitted success: parent death cannot strand a
+        # descendant at the result handoff. No unrelated service is targeted.
+        os.killpg(leader, signal.SIGKILL)
+
+
+def reap_group(process: subprocess.Popen) -> None:
+    expires = time.monotonic() + CLEANUP_SECONDS
+    absent = False
+    # Signal before reaping our still-reserved leader PID. Once reaped, that
+    # numeric PGID can be reused: only non-mutating absence probes are safe.
+    if process.returncode is None:
+        try:
+            os.killpg(process.pid, signal.SIGKILL)
+        except ProcessLookupError:
+            absent = True
+        except PermissionError:
+            pass
+    for _ in range(CLEANUP_RETRIES):
+        if not absent:
+            try:
+                os.killpg(process.pid, 0)
+            except ProcessLookupError:
+                absent = True
+            except PermissionError:
+                pass  # Darwin zombie-only groups can report EPERM until reaped.
+        remaining = expires - time.monotonic()
+        if remaining <= 0:
+            break
+        try:
+            process.wait(timeout=min(0.05, remaining))
+        except subprocess.TimeoutExpired:
+            pass
+        if absent and process.returncode is not None:
+            return
+        time.sleep(min(0.05, max(0, expires - time.monotonic())))
+    raise ProcessCleanupError("owned command group cleanup could not be confirmed", contained=False)
+
+
+def _decode_result(frame: bytes, limit: int) -> dict:
+    header = len(RESULT_MAGIC) + 4
+    if not frame.startswith(RESULT_MAGIC) or not frame.endswith(RESULT_END) or len(frame) <= header + len(RESULT_END):
+        raise ValueError("incomplete command result")
+    length = int.from_bytes(frame[len(RESULT_MAGIC):header], "big")
+    if len(frame) != header + length + len(RESULT_END):
+        raise ValueError("invalid command result length")
+    result = _parse(frame[header:header + length])
+    if (set(result) != {"exit", "stdout", "stderr", "spawnFailed"}
+            or type(result["spawnFailed"]) is not bool
+            or (result["exit"] is not None and (type(result["exit"]) is not int or not -128 <= result["exit"] <= 255))
+            or result["spawnFailed"] != (result["exit"] is None)
+            or type(result["stdout"]) is not str or type(result["stderr"]) is not str):
+        raise ValueError("invalid command result")
+    output = base64.b64decode(result["stdout"], validate=True)
+    errors = base64.b64decode(result["stderr"], validate=True)
+    if len(output) + len(errors) > limit:
+        raise ValueError("command result exceeds output bound")
+    result.update(stdout=output.decode("utf-8"), stderr=errors.decode("utf-8"))
+    return result
+
+
+def run_owned(
+    argv: Sequence[str], *, environ: Mapping[str, str] | None = None, cwd: Path | None = None,
+    timeout: int = 30, capture: bool = True, output_limit: int = PRIVATE_OUTPUT_LIMIT,
+    cancellation: DefaultCancellation | None = None, on_start: Callable[[int], None] | None = None,
+    cleanup: bool = False,
+) -> subprocess.CompletedProcess[str]:
+    """Return only after terminal framing AND cleanup, including successful commands."""
+    if os.name != "posix" or type(timeout) is not int or not 0 < timeout <= 24 * 60 * 60:
+        raise ProcessError("owned commands require POSIX and a bounded positive timeout")
+    request = {"argv": list(argv), "cwd": str(Path.cwd() if cwd is None else cwd.absolute()),
+               "capture": capture, "limit": output_limit}
+    try:
+        _valid_request(request)
+        content = _json(request)
+        if len(content) > REQUEST_LIMIT:
+            raise ValueError()
+    except (ValueError, TypeError, UnicodeError, RecursionError):
+        raise ProcessError("owned command request is invalid or oversized") from None
+    cancellation, owns = cancellation_owner(
+        cancellation, ProcessCleanupError, "owned command cancellation handlers could not be restored",
+    )
+    # A registered cleanup entered because of an already-delivered default
+    # cancellation must still be able to detach resources. It remains bounded;
+    # a fresh recovery command is interruptible normally. Never reset the guard.
+    suppress_cancel = cleanup and cancellation.cancelled and cancellation.depth > 0
+
+    def check_cancel() -> None:
+        if cancellation.pid != os.getpid():
+            raise ProcessCleanupError("inherited command ownership cannot authorize work")
+        if not suppress_cancel:
+            cancellation.check()
+    process = selector = None
+    owner_pid = os.getpid()
+    dispatched, contained = False, True
+    output = bytearray()
+    expires = time.monotonic() + timeout
+    sending = memoryview(REQUEST_MAGIC + len(content).to_bytes(4, "big") + content)
+    frame_limit = ((output_limit + 2) // 3) * 4 + 8192
+
+    def cleanup() -> None:
+        nonlocal selector, contained
+        failed = False
+        if selector is not None:
+            closing, selector = selector, None
+            try:
+                closing.close()
+            except (OSError, ValueError):
+                failed = True
+        if process is not None:
+            try:
+                if owner_pid == os.getpid():
+                    reap_group(process)
+            except (OSError, subprocess.SubprocessError, ProcessError):
+                contained, failed = False, True
+            finally:
+                for name in ("stdin", "stdout"):
+                    stream = getattr(process, name)
+                    if stream is not None:
+                        setattr(process, name, None)
+                        try:
+                            stream.close()
+                        except (OSError, ValueError):
+                            failed = True
+        if failed:
+            raise ProcessCleanupError("owned command resources could not be cleaned up", dispatched=dispatched, contained=contained)
+
+    scope = CleanupScope(cancellation, cleanup, owns_cancellation=owns, fork_cleanup=cleanup)
+    try:
+        try:
+            with scope:
+                if owns:
+                    cancellation.install()
+                    cancellation.activate()
+                check_cancel()
+                with cancellation.deferred():
+                    process = subprocess.Popen(
+                        [sys.executable, "-I", "-S", "-B", "-c", BOOTSTRAP,
+                         str(Path(__file__).resolve().parent.parent), "--supervise", str(os.getpid()), str(expires)],
+                        stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
+                        env=dict(os.environ if environ is None else environ), start_new_session=True,
+                    )
+                    if on_start is not None:
+                        on_start(process.pid)  # MUST precede sending any native command bytes.
+                check_cancel()
+                assert process.stdin is not None and process.stdout is not None
+                os.set_blocking(process.stdin.fileno(), False)
+                os.set_blocking(process.stdout.fileno(), False)
+                with cancellation.deferred():
+                    selector = selectors.DefaultSelector()
+                selector.register(process.stdin, selectors.EVENT_WRITE)
+                selector.register(process.stdout, selectors.EVENT_READ)
+                while True:
+                    check_cancel()  # Interrupt long calls even in a short ownership envelope.
+                    if not selector.get_map():
+                        break
+                    if time.monotonic() >= expires:
+                        raise TimeoutError()
+                    events = selector.select(min(0.05, max(0, expires - time.monotonic())))
+                    check_cancel()  # A raw fork can relinquish handles during select().
+                    for key, mask in events:
+                        if mask & selectors.EVENT_WRITE:
+                            dispatched = True  # Arm before syscall; a partial send can take effect.
+                            try:
+                                count = os.write(key.fd, sending[:64 * 1024])
+                            except BlockingIOError:
+                                continue
+                            if count <= 0:
+                                raise OSError()
+                            sending = sending[count:]
+                            if not sending:
+                                selector.unregister(key.fileobj)
+                                closing, process.stdin = process.stdin, None
+                                try:
+                                    closing.close()
+                                except (OSError, ValueError):
+                                    raise ProcessCleanupError("owned command request cleanup could not be confirmed",
+                                                              dispatched=dispatched, contained=contained) from None
+                        else:
+                            try:
+                                chunk = os.read(key.fd, 64 * 1024)
+                            except BlockingIOError:
+                                continue
+                            if not chunk:
+                                selector.unregister(key.fileobj)
+                            else:
+                                output.extend(chunk)
+                                if len(output) > frame_limit:
+                                    raise ValueError()
+                if time.monotonic() >= expires:
+                    raise ValueError()
+                result = _decode_result(bytes(output), output_limit)
+                if result["spawnFailed"]:
+                    # A complete trusted result proves the native command never
+                    # started, despite transmitting its request to the supervisor.
+                    dispatched = False
+                    raise ProcessError("owned command executable could not be started", dispatched=False)
+        finally:
+            scope.__exit__(*exc_info())
+        if process.returncode != -signal.SIGKILL or time.monotonic() >= expires:
+            raise ValueError()
+        return subprocess.CompletedProcess(list(argv), result["exit"], result["stdout"], result["stderr"])
+    except ProcessError as error:
+        # Guard restoration can raise after dispatch or group cleanup. Its
+        # constructor defaults must not erase the actual lifetime observations.
+        preserve_lifetime_error(error, dispatched=dispatched, contained=contained)
+        raise
+    except KeyboardInterrupt:
+        raise ProcessInterrupted(dispatched=dispatched, contained=contained) from None
+    except (OSError, ValueError, UnicodeError, RecursionError, subprocess.SubprocessError) as error:
+        raise preserve_lifetime_error(
+            ProcessError("owned command failed, timed out, or produced incomplete output"),
+            previous=error, dispatched=dispatched, contained=contained,
+        ) from None
+
+
+def main(argv: list[str] | None = None) -> int:
+    args = sys.argv[1:] if argv is None else argv
+    try:
+        if len(args) != 3 or args[0] != "--supervise":
+            return 1
+        parent, expires = int(args[1]), float(args[2])
+        if not time.monotonic() < expires <= time.monotonic() + 24 * 60 * 60:
+            return 1
+        return supervise(parent, expires)
+    except (OSError, ValueError, RecursionError, subprocess.SubprocessError):
+        return 1  # Never echo native argv, environment, stdout or exceptions.
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
