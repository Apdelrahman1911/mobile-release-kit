+class MatrixRunnerLifetimeTests(unittest.TestCase):
+    def setUp(self):
+        self.root = Path(tempfile.mkdtemp(prefix="mrk-matrix-owner-")).resolve()
+        self.package = Path(mobile_release.__file__).resolve().parent.parent
+        self.child = None
+
+    def tearDown(self):
+        if self.child is not None:
+            runner._stop_owned(self.child)
+            if self.child.stdout: self.child.stdout.close()
+            if self.child.stderr: self.child.stderr.close()
+        for path in self.root.rglob("launcher-owner.json"):
+            runner.wait_absent(json.loads(path.read_bytes())["pid"])
+        for path in self.root.rglob("last-worker.json"):
+            runner.wait_absent(json.loads(path.read_bytes())["pid"])
+        shutil.rmtree(self.root)  # Only after all exact owned groups are absent.
+
+    def test_actual_outer_timeout_reconciles_launcher_and_separate_case_watchdog(self):
+        directory = self.root / "timeout"
+        with self.assertRaises(subprocess.TimeoutExpired):
+            runner.execute_fixture(sys.executable, self.package, directory, "harness-parent-loss", timeout=2)
+        self.assertTrue((directory / "case-live.json").is_file(), "timeout must actually overlap an armed case")
+        self.assertFalse((directory / "proof.json").exists())
+        for name in ("last-worker.json", "launcher-owner.json"):
+            runner.wait_absent(json.loads((directory / name).read_bytes())["pid"])
+
+    def test_owner_record_failure_still_reaps_actual_spawned_launcher(self):
+        directory = self.root / "record-failure"
+        actual = runner.write_record
+        spawned = []
+        def fail_after_spawn(path, value):
+            if path.name == "launcher-owner.json":
+                spawned.append(value["pid"])
+                raise OSError("injected evidence-record failure after real Popen")
+            return actual(path, value)
+        with patch.object(runner, "write_record", side_effect=fail_after_spawn), self.assertRaisesRegex(OSError, "record failure"):
+            runner.execute_fixture(sys.executable, self.package, directory, "harness-parent-loss")
+        self.assertEqual(len(spawned), 1)
+        runner.wait_absent(spawned[0])
+        self.assertFalse((directory / "proof.json").exists())
+
+    def test_hard_outer_owner_loss_cannot_leave_its_launcher_or_case_group_running(self):
+        script = self.root / "outer-owner.py"
+        script.write_text("import sys\nfrom pathlib import Path\n"
+                          f"sys.path.insert(0, {str(runner.ROOT / 'tests')!r})\n"
+                          "from workflow.run_local_signing_matrix import execute_fixture\n"
+                          "execute_fixture(sys.executable, Path(sys.argv[1]), Path(sys.argv[2]), 'harness-parent-loss')\n")
+        for signum in (signal.SIGTERM, signal.SIGKILL):
+            with self.subTest(signum=signum):
+                directory = self.root / str(signum)
+                self.child = subprocess.Popen([sys.executable, "-I", "-B", str(script), str(self.package), str(directory)],
+                                              stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True)
+                expires = time.monotonic() + 8
+                required = [directory / name for name in ("case-live.json", "last-worker.json", "launcher-owner.json")]
+                while not all(path.is_file() for path in required):
+                    self.assertIsNone(self.child.poll())
+                    self.assertLess(time.monotonic(), expires, "outer-owner startup rendezvous failed")
+                    time.sleep(.01)
+                self.assertEqual(json.loads(required[0].read_bytes())["pid"], json.loads(required[1].read_bytes())["pid"])
+                self.child.send_signal(signum)
+                output, error = self.child.communicate(timeout=10)
+                self.assertEqual(self.child.returncode, -signum)
+                self.assertEqual((output, error), (b"", b""))
+                for path in required[1:]: runner.wait_absent(json.loads(path.read_bytes())["pid"])
+                runner.wait_absent(self.child.pid)
+                self.assertFalse((directory / "proof.json").exists())
+
+
+if __name__ == "__main__":
+    unittest.main()
