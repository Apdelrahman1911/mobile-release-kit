+class StreamCloseFailure:
+    def __init__(self, stream, *, before, foreign):
+        self.stream, self.before, self.foreign = stream, before, foreign
+        self.calls = 0
+        self.reused = None
+
+    def __getattr__(self, name):
+        return getattr(self.stream, name)
+
+    def close(self):
+        self.calls += 1
+        if not self.before:
+            descriptor = self.stream.fileno()
+            self.stream.close()
+            self.reused = os.open(self.foreign, os.O_RDONLY)
+            if self.reused != descriptor:
+                os.dup2(self.reused, descriptor)
+                os.close(self.reused)
+                self.reused = descriptor
+        raise OSError("fictional-private-close-canary")
+
+    def finish(self):
+        if not self.stream.closed:
+            self.stream.close()
+        if self.reused is not None:
+            os.close(self.reused)
+            self.reused = None
