@@ -0,0 +1,237 @@
+"""Required bounded crash matrix: source + isolated wheel, then actual-union proof.
+
+This credential-free test gate never invokes native signing tools or Stores.
+One --shard is explicitly partial. --all reconciles this host's sixteen shards;
+the CI aggregate additionally requires both supported OS products.
+"""
+from __future__ import annotations
+
+import argparse
+import gzip
+import hashlib
+import json
+import os
+import signal
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+if __name__ == "__main__":
+    sys.path.insert(0, str(ROOT / "tests"))
+
+from workflow import local_signing_matrix_contract as contract
+
+SHARD_SECONDS = 420
+PAIR_SECONDS = 900
+FIXTURE = ROOT / "tests/workflow/local_signing_persistent_fixture.py"
+
+
+def wait_absent(pid, timeout=5):
+    expires = time.monotonic() + timeout
+    while True:
+        try:
+            os.killpg(pid, 0)
+        except ProcessLookupError:
+            return
+        except PermissionError:
+            pass  # Including Darwin zombie groups: uncertainty, never absence.
+        contract.require(time.monotonic() < expires, f"owned fixture group {pid} survived")
+        time.sleep(.01)
+
+
+def _stop_owned(child):
+    if child.returncode is None:
+        # Unreaped direct child reserves the PID. Never signal a journal PID or
+        # another task's process; after wait/reap only observe absence.
+        try:
+            os.killpg(child.pid, signal.SIGKILL)
+        except ProcessLookupError:
+            pass
+        child.wait(timeout=10)
+    wait_absent(child.pid)
+
+
+def write_record(path, value):
+    pending = path.with_suffix(".pending")
+    with pending.open("xb") as stream:
+        stream.write(contract.canonical(value) + b"\n")
+        stream.flush()
+        os.fsync(stream.fileno())
+    contract.require(not path.exists(), "refusing to replace earlier execution evidence")
+    pending.replace(path)
+
+
+def validate_actual_results(directory, expected):
+    """Reconcile IDs with actual reached cuts, not just the requested selection."""
+    actual = []
+    with gzip.open(directory / "results.jsonl.gz", "rb") as stream:
+        while True:
+            line = stream.readline(2 * 1024 * 1024 + 1)
+            if not line:
+                break
+            contract.require(len(line) <= 2 * 1024 * 1024 and line.endswith(b"\n"), "oversized/incomplete actual result")
+            record = json.loads(line)
+            group = record["seed"]
+            cut_name = "original-cut" if group == "original" else "recovery-cut"
+            cut = record["results"][cut_name]
+            case_id = contract.logical_case_id(group, cut["event"], cut["edge"])
+            contract.require(record["caseId"] == case_id, "result ID disagrees with the actual reached crash cut")
+            actual.append(case_id)
+            contract.require(len(actual) <= len(expected), "extra actual executions")
+            contract.require("final-automatic" in record["results"], "final recovery was not observed")
+            if record["outcome"]["manual"] is not None:
+                contract.require({"final-no-resolution", "final-owner-resolution"} <= set(record["results"]), "manual recheck observations missing")
+    contract.require(actual == expected, "actual crash executions omit, duplicate or reorder assigned cases")
+    return hashlib.sha256((directory / "results.jsonl.gz").read_bytes()).hexdigest()
+
+
+def execute_fixture(python, package_parent, output, mode, *, timeout=SHARD_SECONDS):
+    """Bounded launcher with a second liveness pipe surviving outer hard death."""
+    output.mkdir(mode=0o700)
+    parent_read, parent_write = os.pipe()
+    child = None
+    try:
+        with (output / "launcher.stdout").open("xb") as stdout, (output / "launcher.stderr").open("xb") as stderr:
+            child = subprocess.Popen(
+                [str(python), "-I", "-S", "-B", "-X", "pycache_prefix=" + str(output / "unused-cache"),
+                 str(FIXTURE), str(package_parent), str(output), mode, str(parent_read)],
+                cwd=output, stdin=subprocess.DEVNULL, stdout=stdout, stderr=stderr, start_new_session=True,
+                pass_fds=(parent_read,), env={"PATH": "/usr/bin:/bin", "HOME": str(output), "TMPDIR": str(output),
+                                             "LC_ALL": "C", "LANG": "C"},
+            )
+            closing, parent_read = parent_read, None
+            os.close(closing)
+            write_record(output / "launcher-owner.json", {"pid": child.pid})
+            code = child.wait(timeout=timeout)
+    finally:
+        # No fallible journal/log/descriptor operation may bypass exact child
+        # cleanup. Clear descriptor ownership before one ambiguous close attempt.
+        try:
+            closing, parent_read = parent_read, None
+            if closing is not None:
+                os.close(closing)
+        finally:
+            try:
+                closing, parent_write = parent_write, None
+                if closing is not None:
+                    os.close(closing)
+            finally:
+                # Hard outer death gives the same liveness EOF through kernel
+                # closure, even during a blocked case filesystem operation.
+                if child is not None:
+                    try:
+                        _stop_owned(child)
+                    finally:
+                        for name in ("case", "inventory", ""):
+                            recorded = output / name / "last-worker.json"
+                            if recorded.exists():
+                                wait_absent(json.loads(recorded.read_bytes())["pid"])
+    contract.require(code == 0, f"fixture {mode} failed; preserve {output}")
+    contract.require((output / "launcher.stderr").stat().st_size == 0, "fixture reported unexpected stderr")
+    # On failure the fixture, snapshots and logs are intentionally retained.
+    # A successful fixture removed only its own proven quiescent case trees.
+
+
+def wheel_package(python, output):
+    result = subprocess.run(
+        [str(python), "-I", "-B", "-c", "import mobile_release; from pathlib import Path; print(Path(mobile_release.__file__).resolve().parent)"],
+        cwd=output, stdin=subprocess.DEVNULL, capture_output=True, text=True, check=True, timeout=30,
+    )
+    contract.require(not result.stderr and len(result.stdout.splitlines()) == 1, "unexpected installed-package discovery output")
+    package = Path(result.stdout.strip())
+    contract.require(package.is_absolute() and not package.resolve().is_relative_to(ROOT), "wheel imported checkout instead of isolated installation")
+    return package.resolve()
+
+
+def run_pair(shard, output, wheel_python, operating_system, scope):
+    started = time.monotonic()
+    output.mkdir(mode=0o700)  # Never reuse a failed or previous successful fixture.
+    source = ROOT / "src/mobile_release"
+    wheel = wheel_package(wheel_python, output)
+    package, definitions = contract.package_manifest(source), contract.definitions_manifest(ROOT)
+    contract.require(contract.package_manifest(wheel) == package, "wheel bytes do not match the source package")
+    write_record(output / "package-files.json", package)
+    write_record(output / "test-definition-files.json", definitions)
+    expected, results = None, {}
+    for mode, python, selected_package in (("source", sys.executable, source), ("wheel", wheel_python, wheel)):
+        directory = output / mode
+        execute_fixture(python, selected_package.parent, directory, f"shard/{shard}")
+        observed = json.loads((directory / "matrix-result.json").read_bytes())
+        contract.require(observed["shard"] == shard and observed["productionRoot"] == str(selected_package), "wrong actual package/shard")
+        contract.validate_ids(observed["expectedCaseIds"], "inventoried cases")
+        contract.validate_ids(observed["executedCaseIds"], "actual cases")
+        if expected is None:
+            expected = observed["expectedCaseIds"]
+        contract.require(observed["expectedCaseIds"] == expected, "source/wheel expected inventories differ")
+        results[mode] = {key: observed[key] for key in ("executedCaseIds", "inventorySha256", "packageSha256", "definitionsSha256",
+                                                       "allExactChildrenReapedAndGroupsAbsent", "allCasePathsRemoved")}
+        results[mode]["resultsSha256"] = validate_actual_results(directory, observed["executedCaseIds"])
+    contract.require(contract.package_manifest(source) == package and contract.package_manifest(wheel) == package
+                     and contract.definitions_manifest(ROOT) == definitions, "source/test/wheel changed during the gate")
+    proof = {"schemaVersion": 1, "scope": scope, "shard": shard, "expectedCaseIds": expected,
+             "expectedSha256": contract.digest(expected), **results}
+    contract.validate_proof(proof, contract.artifact_name(scope, shard), scope, contract.digest(package), contract.digest(definitions))
+    contract.require(time.monotonic() - started < PAIR_SECONDS, "source/wheel pair exceeded the unchanged gate deadline")
+    write_record(output / "proof.json", proof)  # Only after complete current pair verification.
+    print(json.dumps({"scope": "PARTIAL: one of sixteen required shards on one OS", "os": operating_system, "shard": shard,
+                      "casesPerPackage": len(proof["source"]["executedCaseIds"]), "seconds": time.monotonic() - started}), flush=True)
+    return proof
+
+
+def operating_system():
+    contract.require(sys.platform in ("linux", "darwin"), "matrix requires Linux or macOS")
+    return "macos-26" if sys.platform == "darwin" else "ubuntu-24.04"
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    mode = parser.add_mutually_exclusive_group(required=True)
+    mode.add_argument("--shard", type=int, choices=range(contract.SHARDS))
+    mode.add_argument("--all", action="store_true")
+    mode.add_argument("--reduce", type=Path, metavar="PROOF_DIRECTORY")
+    parser.add_argument("--wheel-python", type=Path)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--os", choices=contract.OPERATING_SYSTEMS)
+    parser.add_argument("--local-reduction", action="store_true", help="require only this host's OS, never CI")
+    args = parser.parse_args(argv)
+    actual_os = operating_system()
+    contract.require(args.os in (None, actual_os), "requested OS does not match the actual host")
+    contract.require(not args.local_reduction or (args.reduce is not None and os.environ.get("GITHUB_ACTIONS") != "true"), "local reduction cannot replace CI's two-OS gate")
+    output = args.output.resolve()
+    contract.require(not output.exists(), "output already exists; preserve previous evidence and use a fresh path")
+    scope = contract.scope_from_environment(os.environ, actual_os, producer=args.reduce is None)
+    package_sha = contract.digest(contract.package_manifest(ROOT / "src/mobile_release"))
+    definitions_sha = contract.digest(contract.definitions_manifest(ROOT))
+    if args.reduce is not None:
+        contract.require(args.wheel_python is None and not args.all and args.shard is None, "invalid reducer arguments")
+        contract.require(scope["kind"] == "github" or args.local_reduction, "non-CI reduction requires explicit --local-reduction")
+        candidates = ((name, contract.read_proof(path)) for name, path in contract.proof_paths(args.reduce.absolute()))
+        report = contract.reconcile(candidates, scope, package_sha, definitions_sha,
+                                    operating_systems=(actual_os,) if args.local_reduction else contract.OPERATING_SYSTEMS)
+        write_record(output, report)
+        print(json.dumps(report, sort_keys=True))
+        return 0
+    contract.require(args.wheel_python is not None and args.wheel_python.is_file(), "provide an isolated installed wheel's --wheel-python")
+    wheel_python = args.wheel_python.absolute()  # Do not resolve away a venv's executable symlink.
+    if args.all:
+        output.mkdir(mode=0o700)
+        candidates = []
+        for shard in range(contract.SHARDS):
+            name = contract.artifact_name(scope, shard)
+            proof = run_pair(shard, output / name, wheel_python, actual_os, scope)
+            candidates.append((name, proof))
+        report = contract.reconcile(candidates, scope, package_sha, definitions_sha, operating_systems=(actual_os,))
+        write_record(output / "complete-local-union.json", report)
+        print(json.dumps(report, sort_keys=True))
+    else:
+        run_pair(args.shard, output, wheel_python, actual_os, scope)
+    return 0
+
+
+if __name__ == "__main__":
+    def interrupted(_signum, _frame):
+        raise KeyboardInterrupt("signing matrix runner interrupted")
+    signal.signal(signal.SIGTERM, interrupted)
+    raise SystemExit(main())
