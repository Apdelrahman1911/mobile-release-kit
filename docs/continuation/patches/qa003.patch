@@ -0,0 +1,72 @@
+"""Credential-free transaction model: real DB inode replacement, no native calls."""
+from __future__ import annotations
+
+import copy
+import os
+import subprocess
+from pathlib import Path
+
+from mobile_release.local_signing import DB_NAME, LOCK_NAME
+
+
+class NativeSigningModel:
+    def __init__(self, home: Path):
+        self.home = home
+        self.original = {"default": str(home / 'fictional login.keychain-db'),
+                         "search": [str(home / 'fictional login.keychain-db'), str(home / 'f\\ictional أرشيف.keychain-db')]}
+        self.preferences = copy.deepcopy(self.original)
+        self.calls = []
+        self.before = self.after = None
+        self.keychain = None
+        self.revisions = 0
+
+    def transaction(self):
+        self.revisions += 1
+        previous = self.keychain.stat().st_ino
+        stage = self.keychain.parent / "native-atomic-stage"
+        stage.write_bytes(b"fictional-db-revision-" + str(self.revisions).encode())
+        stage.chmod(0o600)
+        stage.replace(self.keychain)
+        assert previous != self.keychain.stat().st_ino
+
+    def __call__(self, argv, *, on_start=None, **kwargs):
+        if on_start is not None:
+            on_start(1073741823)  # No real process/PGID authority in this synchronous model.
+        self.calls.append(list(argv))
+        if self.before is not None:
+            self.before(argv, kwargs)
+        code, stdout, stderr = 0, "", ""
+        command = argv[1] if Path(argv[0]).name == "security" else Path(argv[0]).name
+        if command in {"default-keychain", "list-keychains"}:
+            field = "default" if command == "default-keychain" else "search"
+            if "-s" in argv:
+                value = argv[argv.index("-s") + 1:]
+                self.preferences[field] = value[0] if field == "default" else value
+            else:
+                values = [self.preferences[field]] if field == "default" else self.preferences[field]
+                stdout = ''.join('    "' + path + '"\n' for path in values)
+        elif command == "create-keychain":
+            self.keychain = Path(argv[-1])
+            assert not self.keychain.exists()
+            self.keychain.write_bytes(b"fictional-db")
+            self.keychain.chmod(0o600)
+            lock = self.keychain.parent / LOCK_NAME
+            lock.write_bytes(b"fictional-lock")
+            lock.chmod(0o600)
+        elif command == "delete-keychain":
+            assert str(self.keychain) not in [self.preferences['default'], *self.preferences['search']]
+            self.keychain.unlink()
+            (self.keychain.parent / LOCK_NAME).unlink()
+        elif command in {"set-keychain-settings", "unlock-keychain", "import", "set-key-partition-list", "build"}:
+            self.transaction()
+        elif command == "openssl":
+            assert "-out" in argv
+            Path(argv[argv.index("-out") + 1]).write_bytes(b"fictional-extracted-material")
+        else:
+            raise AssertionError("unmodeled native operation: " + command)
+        result = subprocess.CompletedProcess(argv, code, stdout, stderr)
+        if self.after is not None:
+            replacement = self.after(argv, kwargs, result)
+            if replacement is not None:
+                return replacement
+        return result
