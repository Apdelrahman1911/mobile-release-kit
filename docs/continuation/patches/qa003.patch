+ROOT = Path(__file__).resolve().parents[2]
+if __name__ == "__main__":
+    sys.path[:0] = [sys.argv.pop(1), str(ROOT / "tests")]
+
+from mobile_release import credentials, local_signing as signing
+from mobile_release.errors import CredentialError
+from unit.ios_entitlement_helpers import profile
+from unit.local_signing_persistent import (
+    PROFILE, UUID, OwnerResolutionRefused, PersistentSigningModel, ResourceOracle, facts, initialize, write_json,
+)
+from workflow.local_signing_matrix_contract import (
+    SHARDS, digest, event_fact, logical_case_id, package_manifest, definitions_manifest, shard_for,
+)
+
+CRASH = 73
+WORKER_ERROR = 91
+IO_OPERATIONS = ("open", "write", "fsync", "replace", "unlink", "rmdir", "mkdir", "link", "close", "dup")
+PRODUCTION = {"mobile_release.local_signing", "mobile_release.credentials", "mobile_release.ios_profiles",
+              "mobile_release.cancellation"}
+OUTER_LIVENESS_FD = None
+
+
+def group_absent(pid: int) -> bool:
+    try:
+        os.killpg(pid, 0)
+    except ProcessLookupError:
+        return True
+    except PermissionError:
+        return False  # Darwin's last zombie can remain until its parent reaps it.
+    return False
+
+
+def await_absence(pid: int, seconds: float = 5) -> None:
+    expires = time.monotonic() + seconds
+    while not group_absent(pid):
+        assert time.monotonic() < expires, f"owned case group {pid} survived"
+        time.sleep(.002)
+
+
+def _watchdog(launcher_fd: int, worker_fd: int, timeout: float, armed_fd: int, leader: int) -> None:
+    """Own group only; parent-loss and deadlines still work during blocked IO."""
+    assert os.getpgrp() == leader and os.getppid() == leader, "watchdog has no owned worker group"
+    expires = time.monotonic() + timeout
+    watched = [launcher_fd, worker_fd] + ([] if OUTER_LIVENESS_FD is None else [OUTER_LIVENESS_FD])
+    armed = False
+    while True:
+        remaining = expires - time.monotonic()
+        if remaining <= 0:
+            os.killpg(leader, signal.SIGKILL)
+        # Initialize/validate the actual monitor before announcing readiness.
+        # An already-lost owner must never permit task dispatch.
+        readable, _, _ = select.select(watched, [], [], max(0, remaining) if armed else 0)
+        if OUTER_LIVENESS_FD in readable and os.read(OUTER_LIVENESS_FD, 1) == b"":
+            os.killpg(leader, signal.SIGKILL)
+        if launcher_fd in readable and os.read(launcher_fd, 1) == b"":
+            os.killpg(leader, signal.SIGKILL)
+        if worker_fd in readable and os.read(worker_fd, 1) == b"":
+            os._exit(0)
+        if not armed:
+            assert os.write(armed_fd, b"A") == 1, "incomplete watchdog arming"
+            closing, armed_fd = armed_fd, None
+            os.close(closing)
+            armed = True
+
+
+def run_worker(root: Path, name: str, task, *, timeout: float = 20, expect=0) -> dict:
+    """Keep exact unreaped-child authority until termination, then prove group absence."""
+    assert threading.active_count() == 1, "warm fork launcher must be single-threaded"
+    owner = os.getpid()
+    handles = {}
+    pid = watchdog = None
+    started, reaped, may_signal = time.monotonic(), False, True
+
+    def pipe(label):
+        handles[label + "_read"], handles[label + "_write"] = os.pipe()
+
+    def close(label):
+        # A failed raw close can already have taken effect and its FD been
+        # reused. Relinquish before one attempt, never retry a numeric handle.
+        descriptor = handles.pop(label, None)
+        if descriptor is not None:
+            os.close(descriptor)
+
+    def wait():
+        nonlocal reaped, may_signal
+        # A raised wait can have consumed status. Only a successful zero result
+        # reestablishes that this exact child still reserves signalling authority.
+        may_signal = False
+        waited, status = os.waitpid(pid, os.WNOHANG)
+        if not waited:
+            may_signal = True
+            return None
+        assert waited == pid, "unexpected case child status"
+        reaped = True
+        return status
+
+    try:
+        pipe("launcher")
+        pipe("ready")
+        pid = os.fork()
+        if pid == 0:
+            code = WORKER_ERROR
+            try:
+                close("launcher_write"); close("ready_read")
+                os.setsid()
+                leader = os.getpid()
+                pipe("worker"); pipe("armed")
+                watchdog = os.fork()
+                if watchdog == 0:
+                    try:
+                        close("worker_write"); close("ready_write"); close("armed_read")
+                        _watchdog(handles["launcher_read"], handles["worker_read"], timeout,
+                                  handles.pop("armed_write"), leader)
+                    finally:
+                        # Unexpected monitor errors/returns cannot leave a task
+                        # running without its supervisor or unwind into launcher.
+                        try:
+                            if os.getpgrp() == leader:
+                                os.killpg(leader, signal.SIGKILL)
+                        finally:
+                            os._exit(WORKER_ERROR)
+                close("worker_read"); close("launcher_read"); close("armed_write")
+                readable, _, _ = select.select([handles["armed_read"]], [], [], min(timeout, 5))
+                assert readable and os.read(handles["armed_read"], 2) == b"A", "watchdog did not arm"
+                close("armed_read")
+                message = str(watchdog).encode() + b"\n"
+                assert os.write(handles["ready_write"], message) == len(message), "incomplete case readiness"
+                close("ready_write")
+                value = task()
+                write_json(root / (name + ".json"), value)
+                close("worker_write")
+                waited, status = os.waitpid(watchdog, 0)
+                assert waited == watchdog and os.waitstatus_to_exitcode(status) == 0, "watchdog failed"
+                code = 0
+            except BaseException:
+                try:
+                    write_json(root / (name + "-error.json"), {"traceback": traceback.format_exc()})
+                except BaseException:
+                    pass  # Exit failure remains authoritative if evidence also fails.
+            finally:
+                os._exit(code)  # Every child setup/error path stops here, never in the caller.
+        close("launcher_read"); close("ready_write")
+        readable, _, _ = select.select([handles["ready_read"]], [], [], min(timeout, 5))
+        assert readable, "case worker never armed its independent lifetime supervisor"
+        message = os.read(handles["ready_read"], 64)
+        assert message.endswith(b"\n"), "case worker readiness was incomplete"
+        watchdog = int(message)
+        write_json(root / "last-worker.json", {"pid": pid, "watchdog": watchdog})
+        expires = started + timeout + 5
+        while True:
+            status = wait()
+            if status is not None:
+                code = os.waitstatus_to_exitcode(status)
+                assert code == expect, {"worker": name, "expected": expect, "actual": code,
+                                       "error": (root / (name + "-error.json")).read_text()
+                                       if (root / (name + "-error.json")).exists() else None}
+                break
+            assert time.monotonic() < expires, "case worker survived its independent deadline"
+            time.sleep(.001)
+    finally:
+        # Closing liveness, worker reconciliation and every remaining descriptor
+        # are independent obligations even when another close/observer fails.
+        try:
+            close("launcher_write")
+        finally:
+            try:
+                if owner == os.getpid() and pid is not None and pid > 0:
+                    if not reaped:
+                        if may_signal:
+                            try:
+                                os.killpg(pid, signal.SIGKILL)
+                            except (ProcessLookupError, PermissionError):
+                                try:
+                                    os.kill(pid, signal.SIGKILL)
+                                except ProcessLookupError:
+                                    pass
+                        expires = time.monotonic() + 5
+                        while not reaped:
+                            wait()
+                            assert time.monotonic() < expires, "case child cleanup could not be confirmed"
+                            if not reaped:
+                                time.sleep(.001)
+                    await_absence(pid)
+            finally:
+                try:
+                    with ExitStack() as closing:
+                        for label in tuple(handles):
+                            closing.callback(close, label)
+                finally:
+                    # Also cover a child-side exception at the fork-return
+                    # handoff, before the explicit worker branch is entered.
+                    if os.getpid() != owner:
+                        os._exit(WORKER_ERROR)
+    return {"pid": pid, "watchdog": watchdog, "exit": code, "groupAbsent": True,
+            "elapsed": time.monotonic() - started}
+
+
+def snapshot(root: Path) -> dict:
+    model = json.loads((root / "observed-native.json").read_bytes())
+    lease = root / "home" / signing.LEASE_DIRECTORY
+    sessions = sorted(lease.glob("session-*")) if lease.exists() else []
+    assert len(sessions) <= 1
+    controls = {}
+    if sessions:
+        for path in sessions[0].iterdir():
