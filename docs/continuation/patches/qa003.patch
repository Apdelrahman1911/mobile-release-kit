+"""Abrupt cuts in real local protocol IO; never invokes native signing tools."""
+from __future__ import annotations
+
+import json
+import os
+import sys
+from contextlib import ExitStack
+from pathlib import Path
+from unittest.mock import patch
+
+ROOT = Path(__file__).resolve().parents[2]
+if __name__ == '__main__':
+    sys.path[:0] = [sys.argv.pop(1), str(ROOT / 'tests')]
+
+from mobile_release import local_signing as signing
+from mobile_release.credentials import _temporary_profile_installation
+from unit.local_signing_helpers import NativeSigningModel
+
+
+def main(root: Path, cut: int, edge: str) -> None:
+    home = root / 'home'
+    home.mkdir(mode=0o700, exist_ok=True)
+    trace = []
+    real_write, real_open = os.write, os.open
+    log = real_open(root / 'cuts.jsonl', os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
+    model = NativeSigningModel(home)
+    index = 0
+    def boundary(operation, event):
+        nonlocal index
+        if event == 'before': index += 1
+        record = {'index':index, 'operation':operation, 'edge':event}
+        real_write(log, (json.dumps(record)+'\n').encode())
+        if cut == index and edge == event:
+            os._exit(73)
+
+    def wrapper(name, original):
+        def invoke(*args, **kwargs):
+            # Every production-control syscall, including read-only opens. Native
+            # model operations are absent from this protocol-only cut matrix.
+            frame = sys._getframe(1)
+            relevant = frame.f_globals.get('__name__') in {'mobile_release.local_signing', 'mobile_release.credentials'}
+            if relevant: boundary(name, 'before')
+            if relevant and cut == index and edge == 'partial' and name == 'write':
+                original(args[0], args[1][:max(1,len(args[1])//2)])
+                os._exit(73)
+            try:
+                return original(*args, **kwargs)
+            finally:
+                # Failed syscalls have a terminal cut point too (e.g. opening
+                # an absent committed control); do not invent an executed pass.
+                if relevant: boundary(name, 'after')
+        return invoke
+
+    with ExitStack() as patches:
+        for name in ('open', 'write', 'fsync', 'replace', 'unlink', 'rmdir', 'mkdir'):
+            patches.enter_context(patch.object(os, name, new=wrapper(name, getattr(os,name))))
+        with signing.local_signing_lease(home=home) as lease:
+            session = lease.session(token='a'*32)
+            session.bind_runner(model)
+            session.open(create=True)
+            content, uuid = b'fictional-authenticated-profile', '12345678-1234-1234-1234-1234567890AB'
+            session.prepare(content, uuid)
+            with _temporary_profile_installation(content, uuid, home, cancellation=lease.cancellation,
+                                                 observer=session.profile_event, reserved_stage=session.intent['profile']['stage']):
+                pass
+            session.cleanup_native()
+            session.cleanup_profile()
+            session.finish()
+    os.close(log)
+    print(json.dumps({'count': index, 'completed': True}))
+
+
+if __name__ == '__main__': main(Path(sys.argv[1]), int(sys.argv[2]), sys.argv[3])
