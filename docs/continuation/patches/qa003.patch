+        for borrowed in (False, True):
+            for signum in (signal.SIGINT, signal.SIGTERM):
+                for fail_cleanup in (False, True):
+                    with self.subTest(borrowed=borrowed, signum=signum, fail_cleanup=fail_cleanup):
+                        guard = DefaultCancellation(owned.ProcessCleanupError, "fictional restoration") if borrowed else None
+                        actual_spawn = subprocess.Popen
