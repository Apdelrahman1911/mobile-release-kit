+if __name__ == "__main__":
+    assert len(sys.argv) in (3, 4), "usage: fixture PACKAGE ROOT MODE [OWNER_FD]"
+    if len(sys.argv) == 4:
+        OUTER_LIVENESS_FD = int(sys.argv[3])
+        os.fstat(OUTER_LIVENESS_FD)
+    print(json.dumps(main(Path(sys.argv[1]), sys.argv[2])))
