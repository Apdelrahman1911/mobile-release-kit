+fn admit_request_body<'a>(body: &p::RequestBody, active: &'a AtomicBool, held: &mut Option<MetadataExchange<'a>>) -> Result<(), Error> {
+    if metadata_request(body) { MetadataExchange::require(active, held)?; }
