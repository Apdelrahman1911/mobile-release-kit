{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mobile-release-kit:schema:project:1",
  "title": "Mobile Release Kit project configuration",
  "description": "Application-owned policy and the small set of release settings that cannot be discovered safely.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "source",
    "android",
    "ios",
    "metadata",
    "services",
    "projectChecks"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "format": "uri",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s\\u0000\\r\\n]+$"
    },
    "schemaVersion": {
      "const": 1
    },
    "version": {
      "$ref": "#/$defs/versionSource"
    },
    "source": {
      "$ref": "#/$defs/sourcePolicy"
    },
    "android": {
      "$ref": "#/$defs/android"
    },
    "ios": {
      "$ref": "#/$defs/ios"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "services": {
      "$ref": "#/$defs/services"
    },
    "projectChecks": {
      "$ref": "#/$defs/projectChecks"
    }
  },
  "anyOf": [
    {
      "properties": {
        "android": {
          "properties": {
            "enabled": {
              "const": true
            }
          },
          "required": ["enabled"]
        }
      }
    },
    {
      "properties": {
        "ios": {
          "properties": {
            "enabled": {
              "const": true
            }
          },
          "required": ["enabled"]
        }
      }
    }
  ],
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*[\\u0000\\r\\n])(?!.*\\\\)(?!\\.{1,2}(?:/|$))(?!.*(?:/\\.{1,2})(?:/|$))(?!.*//)(?!.*/$).+$"
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^(?!/)(?!.*[\\u0000\\r\\n])(?!.*(?:\\.\\.|//|@\\{|\\\\|[ ~^:?*\\[]))(?!.*[./]$).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "certificateSha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[A-Fa-f0-9]{64}$"
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^(?!.*[\\u0000\\r\\n`])(?!.*\\$\\()(?:(?!\\$\\{).|\\$\\{(?:MOBILE_RELEASE_AAB_PATH|MOBILE_RELEASE_IPA_PATH|MOBILE_RELEASE_DSYM_PATH)\\})+$"
      }
    },
    "commands": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/argv"
      }
    },
    "versionSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "nameKey", "buildKey"],
      "properties": {
        "source": {
          "$ref": "#/$defs/relativePath"
        },
        "nameKey": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "buildKey": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        }
      }
    },
    "sourcePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateBranch", "productionBranch"],
      "properties": {
        "candidateBranch": {
          "$ref": "#/$defs/branch"
        },
        "productionBranch": {
          "$ref": "#/$defs/branch"
        },
        "projectReadTokenRequired": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "externalTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^(?=.*\\S)[^\\u0000\\r\\n]+$",
          "not": {
            "enum": ["internal", "production"]
          }
        },
        "kind": {
          "enum": ["closed", "open"]
        }
      }
    },
    "android": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "applicationId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$"
        },
        "identityStatus": {
          "enum": ["unverified", "approved", "blocked"]
        },
        "module": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^(?::$|:[A-Za-z0-9_.-]+(?::[A-Za-z0-9_.-]+)*)$"
        },
        "variant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "externalTrack": {
          "$ref": "#/$defs/externalTrack"
        },
        "uploadCertificateSha256": {
          "$ref": "#/$defs/certificateSha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": ["enabled"]
          },
          "then": {
            "required": [
              "applicationId",
              "identityStatus"
            ]
          },
          "else": {
            "maxProperties": 1
          }
        },
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              },
              "identityStatus": {
                "const": "approved"
              }
            },
            "required": ["enabled", "identityStatus"]
          },
          "then": {
            "required": ["externalTrack", "uploadCertificateSha256"]
          }
        }
      ]
    },
    "symbols": {
      "type": "object",
      "description": "dSYM retention policy. In v0.1, required is a fail-closed activation sentinel; uploadCommand is validated but never executed.",
      "additionalProperties": false,
      "required": ["policy"],
      "properties": {
        "policy": {
          "enum": ["disabled", "retain", "required"]
        },
        "uploadCommand": {
          "description": "Reserved argv contract for a future separately guarded candidate-stage integration; v0.1 never executes it.",
          "$ref": "#/$defs/argv"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "policy": {
                "const": "required"
              }
            },
            "required": ["policy"]
          },
          "then": {
            "required": ["uploadCommand"]
          },
          "else": {
            "not": {
              "required": ["uploadCommand"]
            }
          }
        }
      ]
    },
    "iosReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["usesNonExemptEncryption", "demoAccountRequired"],
      "properties": {
        "usesNonExemptEncryption": {
          "type": "boolean"
        },
        "demoAccountRequired": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "ios": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "bundleId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "pattern": "^[A-Za-z][A-Za-z0-9-]*(?:\\.[A-Za-z][A-Za-z0-9-]*)+$"
        },
        "identityStatus": {
          "enum": ["unverified", "approved", "blocked"]
        },
        "appStoreAppId": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        },
        "teamId": {
          "type": "string",
          "pattern": "^[A-Z0-9]{10}$"
        },
        "project": {
          "$ref": "#/$defs/relativePath"
        },
        "workspace": {
          "$ref": "#/$defs/relativePath"
        },
        "scheme": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^(?=.*\\S)[^\\u0000\\r\\n]+$"
        },
        "archiveConfiguration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^(?=.*\\S)[^\\u0000\\r\\n]+$"
        },
        "prepareCommand": {
          "$ref": "#/$defs/argv"
        },
        "externalTestFlightGroup": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^(?=.*\\S)[^\\u0000\\r\\n]+$"
        },
        "distributionCertificateSha256": {
          "$ref": "#/$defs/certificateSha256"
        },
        "symbols": {
          "$ref": "#/$defs/symbols"
        },
        "review": {
          "$ref": "#/$defs/iosReview"
        }
      },
      "allOf": [
        {
          "not": {
            "required": ["project", "workspace"]
          }
        },
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": ["enabled"]
          },
          "then": {
            "required": [
              "bundleId",
              "identityStatus"
            ]
          },
          "else": {
            "maxProperties": 1
          }
        },
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              },
              "identityStatus": {
                "const": "approved"
              }
            },
            "required": ["enabled", "identityStatus"]
          },
          "then": {
            "required": [
              "appStoreAppId",
              "teamId",
              "externalTestFlightGroup",
              "distributionCertificateSha256",
              "symbols",
              "review"
            ]
          }
        }
      ]
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-[A-Z]{2}|-[0-9]{3})?$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "androidLocales", "iosLocales"],
      "properties": {
        "root": {
          "$ref": "#/$defs/relativePath"
        },
        "androidLocales": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/locale"
          }
        },
        "iosLocales": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/locale"
          }
        }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "required": ["androidFirebase", "iosFirebase"],
      "properties": {
        "androidFirebase": {
          "enum": ["disabled", "required"]
        },
        "iosFirebase": {
          "enum": ["disabled", "required"]
        }
      }
    },
    "projectChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preflight", "androidArtifact", "iosArtifact"],
      "properties": {
        "preflight": {
          "$ref": "#/$defs/commands"
        },
        "androidArtifact": {
          "$ref": "#/$defs/commands"
        },
        "iosArtifact": {
          "$ref": "#/$defs/commands"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "android": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": ["enabled"]
          }
        }
      },
      "then": {
        "properties": {
          "metadata": {
            "properties": {
              "androidLocales": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ios": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": ["enabled"]
          }
        }
      },
      "then": {
        "properties": {
          "metadata": {
            "properties": {
              "iosLocales": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
