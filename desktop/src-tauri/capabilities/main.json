{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Fixed passive queries; finite local configuration, workflows, public metadata and saved-version edits; reviewed saved offline checks, Android builds, unsigned full-Xcode Mac archives and owned build-input recovery; qualified session or encrypted credential management. GitHub preflight permits only publisher-bound caller review, one-use nonpublishing dispatch and exact original-run observation. Build tools can execute trusted project code only under native runtime/tool custody. No general HTTP, remote writes, event emission, filesystem, shell or opener authority; listen/unlisten is for owner status only.",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "allow-app-info", "allow-choose-project", "allow-choose-project-path", "allow-project-snapshot", "allow-catalog",
    "allow-environment-requirements", "allow-release-version-observe",
    "allow-artifact-evidence-choose", "allow-artifact-evidence-status", "allow-artifact-evidence-observe", "allow-artifact-evidence-cancel",
    "allow-release-evidence-choose", "allow-release-evidence-status", "allow-release-evidence-observe", "allow-release-evidence-cancel",
    "allow-start-environment-diagnostics", "allow-environment-diagnostics-status", "allow-cancel-environment-diagnostics",
    "allow-prepare-offline-preflight", "allow-start-offline-preflight", "allow-offline-preflight-status", "allow-cancel-offline-preflight",
    "allow-prepare-android-build", "allow-start-android-build", "allow-android-build-status", "allow-cancel-android-build",
    "allow-prepare-project-recovery", "allow-start-project-recovery", "allow-project-recovery-status", "allow-cancel-project-recovery",
    "allow-prepare-ios-archive", "allow-start-ios-archive", "allow-ios-archive-status", "allow-cancel-ios-archive",
    "allow-validate-config", "allow-suggest-config", "allow-preview-config", "allow-propose-github-setup",
    "allow-open-config-edit", "allow-prepare-config-edit", "allow-apply-config-edit",
    "allow-close-config-edit", "allow-config-edit-status",
    "allow-github-workflow-edit-open", "allow-github-workflow-edit-prepare", "allow-github-workflow-edit-apply",
    "allow-github-workflow-edit-close", "allow-github-workflow-edit-status",
    "allow-metadata-text-observe", "allow-metadata-text-validate", "allow-metadata-text-edit-open", "allow-metadata-text-edit-prepare",
    "allow-metadata-text-edit-apply", "allow-metadata-text-edit-close", "allow-metadata-text-edit-status",
    "allow-release-version-edit-open", "allow-release-version-edit-prepare", "allow-release-version-edit-apply",
    "allow-release-version-edit-close", "allow-release-version-edit-status",
    "allow-github-connection-status", "allow-github-connection-connect-token", "allow-github-connection-refresh", "allow-github-connection-disconnect",
    "allow-github-preflight-status", "allow-github-preflight-prepare", "allow-github-preflight-dispatch", "allow-github-preflight-track",
    "allow-github-preflight-reconcile", "allow-github-preflight-pending", "allow-github-preflight-cancel",
    "allow-vault-status", "allow-vault-open", "allow-vault-prepare-initialize", "allow-vault-unlock", "allow-asset-context", "allow-asset-choose", "allow-credential-prepare",
    "allow-vault-prepare-delete", "allow-vault-commit", "allow-vault-bind", "allow-vault-discard", "allow-vault-lock",
    "core:event:allow-listen", "core:event:allow-unlisten"
  ]
}
