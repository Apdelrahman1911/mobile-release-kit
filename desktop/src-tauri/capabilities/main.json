{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Fixed passive queries, finite configuration or local workflow editing and closed session-only credential commands with native owner qualification. Listen/unlisten for owner status only; no event emission, general filesystem, shell, opener, or remote authority.",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "allow-app-info", "allow-choose-project", "allow-project-snapshot", "allow-catalog",
    "allow-validate-config", "allow-suggest-config", "allow-preview-config", "allow-propose-github-setup",
    "allow-open-config-edit", "allow-prepare-config-edit", "allow-apply-config-edit",
    "allow-close-config-edit", "allow-config-edit-status",
    "allow-github-workflow-edit-open", "allow-github-workflow-edit-prepare", "allow-github-workflow-edit-apply",
    "allow-github-workflow-edit-close", "allow-github-workflow-edit-status",
    "allow-vault-status", "allow-vault-open", "allow-asset-context", "allow-asset-choose", "allow-credential-prepare",
    "allow-vault-prepare-delete", "allow-vault-commit", "allow-vault-bind", "allow-vault-discard", "allow-vault-lock",
    "core:event:allow-listen", "core:event:allow-unlisten"
  ]
}
